# Copy to .env.local and fill in. Never commit the real file.

# Postgres connection string. Leave empty to use the built-in local database in .data/ (fine for trying it out).
# For a real deployment create a database yourself (Supabase, Neon, RDS, ...) and paste its connection string here.
DATABASE_URL=

# Sign up is open only while there are no accounts. Set to true only if other people should be able to create accounts.
ALLOW_SIGNUP=false

# AI document scanning (optional). Paste your own Anthropic API key to let the app read PDFs, photos, Word, Excel and other files.
# Create a key at console.anthropic.com. The key stays on this computer; the app never stores it in the database.
ANTHROPIC_API_KEY=
# Which model reads the documents. Leave empty to use the default (claude-sonnet-5-5).
AI_MODEL=
